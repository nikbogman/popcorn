DATABASE_URL=postgres://user:password@127.0.0.1:5432/popcorn
# The one password the app logs in with. `uv run python -m app.password` sets a random one.
LOGIN_PASSWORD=change-me
TMDB_API_KEY=your-tmdb-v3-api-key
GEMINI_API_KEY=free-key-from-aistudio.google.com/apikey
# Minutes without a reel job before the scraper's Chromium closes (it relaunches on the next one).
BROWSER_IDLE_MINUTES=5
